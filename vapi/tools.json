{
  "_comment": "Create each of these as a Function tool in Vapi (Tools → Create Tool → Function). Server URL = https://<your-host>/vapi/webhook for all three. Then attach them to the assistant.",
  "tools": [
    {
      "type": "function",
      "async": false,
      "messages": [{"type": "request-start", "content": "One moment while I check our records."}],
      "function": {
        "name": "check_existing_patient",
        "description": "Look up whether a patient already exists for a phone number. Call as soon as the caller has given their phone number.",
        "parameters": {
          "type": "object",
          "properties": {"phone_number": {"type": "string", "description": "10 digits, no punctuation"}},
          "required": ["phone_number"]
        }
      },
      "server": {"url": "https://YOUR-HOST/vapi/webhook", "secret": "SAME_VALUE_AS_VAPI_SECRET_ENV"}
    },
    {
      "type": "function",
      "async": false,
      "messages": [{"type": "request-start", "content": "Perfect, saving that now."}],
      "function": {
        "name": "register_patient",
        "description": "Save a NEW patient record. Only call AFTER the caller confirmed the read-back. Omit optional fields the caller did not provide.",
        "parameters": {
          "type": "object",
          "properties": {
            "first_name": {"type": "string"},
            "last_name": {"type": "string"},
            "date_of_birth": {"type": "string", "description": "MM/DD/YYYY"},
            "sex": {"type": "string", "enum": ["Male", "Female", "Other", "Decline to Answer"]},
            "phone_number": {"type": "string", "description": "10 digits"},
            "email": {"type": "string"},
            "address_line_1": {"type": "string"},
            "address_line_2": {"type": "string", "description": "Apt/Suite/Unit, only if given"},
            "city": {"type": "string"},
            "state": {"type": "string", "description": "2-letter US state abbreviation"},
            "zip_code": {"type": "string", "description": "5 digits or ZIP+4"},
            "insurance_provider": {"type": "string"},
            "insurance_member_id": {"type": "string"},
            "preferred_language": {"type": "string", "description": "Defaults to English"},
            "emergency_contact_name": {"type": "string"},
            "emergency_contact_phone": {"type": "string", "description": "10 digits"}
          },
          "required": ["first_name", "last_name", "date_of_birth", "sex", "phone_number", "address_line_1", "city", "state", "zip_code"]
        }
      },
      "server": {"url": "https://YOUR-HOST/vapi/webhook", "secret": "SAME_VALUE_AS_VAPI_SECRET_ENV"}
    },
    {
      "type": "function",
      "async": false,
      "messages": [{"type": "request-start", "content": "Updating your record now."}],
      "function": {
        "name": "update_patient",
        "description": "Update an EXISTING patient (use patient_id from check_existing_patient). Send only the fields that change. Call after the caller confirmed the changes.",
        "parameters": {
          "type": "object",
          "properties": {
            "patient_id": {"type": "string"},
            "first_name": {"type": "string"},
            "last_name": {"type": "string"},
            "date_of_birth": {"type": "string", "description": "MM/DD/YYYY"},
            "sex": {"type": "string", "enum": ["Male", "Female", "Other", "Decline to Answer"]},
            "phone_number": {"type": "string"},
            "email": {"type": "string"},
            "address_line_1": {"type": "string"},
            "address_line_2": {"type": "string"},
            "city": {"type": "string"},
            "state": {"type": "string"},
            "zip_code": {"type": "string"},
            "insurance_provider": {"type": "string"},
            "insurance_member_id": {"type": "string"},
            "preferred_language": {"type": "string"},
            "emergency_contact_name": {"type": "string"},
            "emergency_contact_phone": {"type": "string"}
          },
          "required": ["patient_id"]
        }
      },
      "server": {"url": "https://YOUR-HOST/vapi/webhook", "secret": "SAME_VALUE_AS_VAPI_SECRET_ENV"}
    }
  ]
}
